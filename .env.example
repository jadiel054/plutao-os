# Plutão — environment variables (copy to .env.local / .env and fill in)
# NEVER commit real secrets.

# Neon Postgres — application traffic (pooled)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Neon Postgres — migrations / drizzle-kit (direct, unpooled)
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# Auth secrets (generate with: openssl rand -base64 32)
AUTH_SECRET=
