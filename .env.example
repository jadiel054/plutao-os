# Plutão — environment variables
# Copy to .env.local (local) or set in Vercel Project Settings (deploy).
# NEVER commit real secrets. NEVER prefix DB URLs with NEXT_PUBLIC_ (server-only).

# --- Database (Neon) ---
# Application runtime, /api/health, serverless queries (POOLED connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/plutao?sslmode=require

# Migrations / drizzle-kit ONLY (DIRECT connection string, no -pooler)
# Do not run migrate against the existing Neon without explicit approval.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/plutao?sslmode=require

# --- Auth (Phase 1.x — not implemented yet; placeholder) ---
# Generate: openssl rand -base64 32
AUTH_SECRET=

# --- Storage Mode ---
# Seleciona o backend de storage para o Filesystem Tool
# Opções: "memory" (desenvolvimento local), "vercel-blob" (produção)
STORAGE_MODE=memory

# --- Vercel Blob Storage ---
# Token de acesso para leitura/escrita no Vercel Blob
# Gerado em: https://vercel.com/dashboard/storage/blob
# Requer permissões: Read & Write
BLOB_READ_WRITE_TOKEN=
