# Plutão — environment variables
# Copy to .env.local (local) or set in Vercel Project Settings (deploy).
# NEVER commit real secrets. NEVER prefix DB URLs with NEXT_PUBLIC_ (server-only).

# --- Database (Neon) ---
# Application runtime, /api/health, serverless queries (POOLED connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/plutao?sslmode=require

# Migrations / drizzle-kit ONLY (DIRECT connection string, no -pooler)
# Do not run migrate against the existing Neon without explicit approval.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/plutao?sslmode=require

# --- Auth / session ---
# Generate: openssl rand -base64 32
SESSION_SECRET=
AUTH_SECRET=

# --- Storage Mode ---
# Opções: "memory" (desenvolvimento local), "vercel-blob" (produção)
STORAGE_MODE=memory

# --- Vercel Blob Storage ---
# https://vercel.com/dashboard/storage/blob
BLOB_READ_WRITE_TOKEN=

# --- Hybrid Model Mode ---
DEFAULT_MODEL_MODE=auto
OFFLINE_MODEL_ID=Xenova/Llama-3.2-3B-Instruct-q4
ONLINE_MODEL_ID=openai/gpt-oss-120b

# --- Online model API (Groq / OpenAI-compatible) ---
MODEL_API_KEY=
MODEL_BASE_URL=https://api.groq.com/openai/v1

# --- App URL (OAuth callbacks, links absolutos) ---
# Produção: https://seu-dominio  |  Local: http://localhost:3000
APP_URL=http://localhost:3000

# --- Autenticação Social (Google & GitHub) ---
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
RESEND_API_KEY=

# --- Conectores (OAuth) — GitHub primeiro ---
# GitHub → Settings → Developer settings → OAuth Apps
# Authorization callback URL: {APP_URL}/api/connectors/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Criptografia de tokens de conector em repouso (AES-256-GCM).
# Se vazio, usa SESSION_SECRET (mín. 16 caracteres) — reuso de chave.
# Recomendado: definir CONNECTOR_TOKEN_SECRET e SESSION_SECRET separados.
CONNECTOR_TOKEN_SECRET=

# --- MCP OAuth 2.1 ---
MCP_TOKEN_SECRET=
PLUTAO_MCP_API_KEY=
PLUTAO_MCP_USER_ID=
# HTTPS callback URIs completas e exatas (origin + path + query).
# Vazio recusa HTTPS; em desenvolvimento o callback permitido é
# http://localhost:<porta>/callback ou http://127.0.0.1:<porta>/callback.
MCP_OAUTH_REDIRECT_ALLOWLIST=https://cliente.example/oauth/callback?client=plutao

# --- Aegis / agent execute smoke (Fase 0) ---
# Fail-closed: without this key, POST/GET /api/agent/execute return 503.
# Generate: openssl rand -base64 32
AEGIS_API_KEY=

# PAT fine-grained restrito ao repo sandbox de smoke (não use classic com scope amplo).
# Só necessário se algum fluxo de smoke write for reintroduzido via H1 write gate.
GITHUB_TOKEN=

# Alvo sandbox do smoke (defaults seguros no código se omitidos).
SMOKE_GITHUB_OWNER=jadiel054
SMOKE_GITHUB_REPO=aegis-smoke-sandbox
SMOKE_GITHUB_BRANCH=main

# Segredo para rotas de cron (/api/cron/*). Header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Nota CONNECTOR_TOKEN_SECRET: se vazio, o runtime cai para SESSION_SECRET.
# Recomendado: definir os dois separados (não reutilizar a mesma chave).

# --- Computador do Plutão (fases 1–5, ver docs/COMPUTADOR_DO_PLUTAO.md) ---
# Provedor do navegador remoto: browserless (default) | self-hosted
PLUTAO_COMPUTER_PROVIDER=browserless
# Browserless Cloud (server-only; sem valor o produto fica no modo preview de sandbox)
BROWSERLESS_API_TOKEN=
BROWSERLESS_ENDPOINT=wss://production-sfo.browserless.io/chromium
# Teto da sessão (plano Free: 120000 ms máximo por conexão)
BROWSERLESS_MAX_SESSION_MS=110000
# Orçamento mensal em unidades (1 un = 30s de navegador; Free = 1000, sem overage)
PLUTAO_COMPUTER_MONTHLY_UNITS=1000
# Futuro mini PC (mesma rota CDP; browserless docker) — desabilitado sem endpoint
SELF_HOSTED_COMPUTER_ENDPOINT=
SELF_HOSTED_COMPUTER_TOKEN=
SELF_HOSTED_MAX_SESSION_MS=
