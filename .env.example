# Plutão — environment variables
# Copy to .env.local (local) or set in Vercel Project Settings (deploy).
# NEVER commit real secrets. NEVER prefix DB URLs with NEXT_PUBLIC_ (server-only).

# --- Database (Neon) ---
# Application runtime, /api/health, serverless queries (POOLED connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/plutao?sslmode=require

# Migrations / drizzle-kit ONLY (DIRECT connection string, no -pooler)
# Do not run migrate against the existing Neon without explicit approval.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/plutao?sslmode=require

# --- Auth / session ---
# Generate: openssl rand -base64 32
SESSION_SECRET=
AUTH_SECRET=

# --- Storage Mode ---
# Opções: "memory" (desenvolvimento local), "vercel-blob" (produção)
STORAGE_MODE=memory

# --- Vercel Blob Storage ---
# https://vercel.com/dashboard/storage/blob
BLOB_READ_WRITE_TOKEN=

# --- Hybrid Model Mode ---
DEFAULT_MODEL_MODE=auto
OFFLINE_MODEL_ID=Xenova/Llama-3.2-3B-Instruct-q4
ONLINE_MODEL_ID=openai/gpt-oss-120b

# --- Online model API (Groq / OpenAI-compatible) ---
MODEL_API_KEY=
MODEL_BASE_URL=https://api.groq.com/openai/v1

# --- App URL (OAuth callbacks, links absolutos) ---
# Produção: https://seu-dominio  |  Local: http://localhost:3000
APP_URL=http://localhost:3000

# --- Autenticação Social (Google & GitHub) ---
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
RESEND_API_KEY=

# --- Conectores (OAuth) — GitHub primeiro ---
# GitHub → Settings → Developer settings → OAuth Apps
# Authorization callback URL: {APP_URL}/api/connectors/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Criptografia de tokens de conector em repouso (AES-256-GCM).
# Se vazio, usa SESSION_SECRET (mín. 16 caracteres).
CONNECTOR_TOKEN_SECRET=
